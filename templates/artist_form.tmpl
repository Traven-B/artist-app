{{define "artist_form"}}
<h2>Add Artist Form</h2>

<form id="add-artist-form" method="post" action="/add-artist" name="add-artist-form" hx-encoding="multipart/form-data">

    <label>Name: <input type="text" name="name" value="{{.FormData.Name}}">
    {{if .FormData.NameMsg}}
        <small class="form-help">{{.FormData.NameMsg}} </small>
    {{end}}
    </label>

    <input type="hidden" name="original_name" value="{{.FormData.OriginalName}}">

    <div id="search-links-area" class="action-row">
        <a href="https://www.google.com/search?q=art+by+{{.FormData.Name | html}}" target="_blank">Google: {{.FormData.Name}}</a> | <a href="https://www.google.com/search?q=very+short+telegraphic+description+of+art+style+of+%22{{.FormData.Name | html}}%22+around+twenty+words&amp;udm=50" target="_blank">AI</a> | <a href="https://www.google.com/search?q={{printf "Generate a \"Visual DNA\" profile for artist \"%s\". Output **only one line** following this exact format: Medium | Subject | Visual Traits | Style | Context. Keep it extremely concise and telegraphic. Example: woodblock print | landscapes, nature, weather | bokashi gradients, atmospheric composition, forced perspective | ukiyo-e | traditional japanese printmaking" .FormData.Name}}&udm=50" target="_blank">AI Features</a> | <a href="https://www.google.com/search?tbm=isch&amp;q=art+by+{{.FormData.Name | html}}+(filetype:jpg+OR+filetype:png)" target="_blank">JPG/PNG</a>
    </div>
    <div class="action-row">
        <button type="button"
            id="check-duplicates-btn"
            hx-post="/check-name"
            hx-include="#add-artist-form input[name=name]"
            hx-target="#artist-form"
            hx-swap="innerHTML">
            Check Duplicates
        </button>

        <button
            type="button"
            id="remove-from-list-btn"
            hx-post="/confirm-delete-todo-form"
            hx-include="#add-artist-form input[name=original_name]"
            hx-target="#test-dialog"
            hx-swap="innerHTML"
            hx-on::after-request="document.getElementById('test-dialog').showModal()">
            Delete (and Clear)
        </button>

        <button type="button"
            class="cancel-btn"
            hx-post="/cancel-add-form"
            hx-target="#artist-form"
            hx-swap="innerHTML">
            Cancel
        </button>
    </div>

    <label>Description: <textarea name="desc" rows="5">{{.FormData.Desc}}</textarea>
    {{if .FormData.DescMsg}}
        <small class="form-help">{{.FormData.DescMsg}}</small>
    {{end}}
    </label>

    <label>Features: <textarea name="features" rows="3">{{.FormData.Features}}</textarea>
    </label>

    <label>Image (File or URL): 
        <input type="file" name="image" accept=".png,.jpg,.jpeg">
        <input type="text" name="img_url" value="{{.FormData.ImgURL}}" placeholder="...or paste image URL" style="margin-top: 4px;">

    {{if .FormData.ImgMsg}}
        <small class="form-help">{{.FormData.ImgMsg}} </small>
    {{end}}
    </label>

    <button type="submit" hx-post="/submit-artist-add-form" hx-include="#add-artist-form">Add Artist</button>
</form>

{{end}}
