{{define "gallery_page"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <link href="static/daft.css" rel="stylesheet" />
    <link href="static/daft-overrides.css" rel="stylesheet" />
    <link href="static/todo.css" rel="stylesheet" />
    <link href="static/env-ribbon.css" rel="stylesheet" />
    <link href="static/site-measure.css" rel="stylesheet" />
    <link href="static/main.css" rel="stylesheet" />

    <title>Artist Gallery</title>
</head>
<body>
  {{if .IsTestMode}}
  <div class="env-ribbon">TEST MODE</div>
  {{end}}

  <!-- Header / Navigation -->
  <header class="container">
    <nav>
      <ul class="title">
        <li>
          <strong>Artist Gallery</strong>
          <a href="https://github.com/Traven-B/artist-app/blob/main/README.md" target="_blank" title="see project on github" style="vertical-align: middle; margin-left: 8px; display: inline-flex;">
            <svg height="30" viewBox="0 0 16 16" width="30" style="fill: currentColor; display: inline-block;">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>
        </li>
      </ul>
      <ul class="links">
        <li><a href="/">Add Artist</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="https://www.artbreeder.com/browse?modelNames=collage.&sort=trending" target="_blank">Artbreeder</a></li>
      </ul>
    </nav>
  </header>

  <!-- Wide Grid Section -->
  <div class="wide-where-grid-goes">
    <div class="grid-container" id="gallery-grid">
      {{range .Artists}}
        {{template "grid_item" .}}
      {{end}}
    </div>
  </div>

  <div class="container">
    <!-- Persistent Edit Form Area -->
    <section id="edit-section" style="padding: 2rem; background: #f9f9f9; border-top: 1px solid #ccc; margin-top: 2rem;">
        <h3>Edit Artist Details</h3>
        <div id="edit-form-target">
            <p>Click "edit" on a card above to load its data here.</p>
        </div>
    </section>

    <!-- Alpine workspace -->
    <div x-data @artist-deleted.window="$store.promptStore.remove($event.detail.id)">

  <div style="text-align:center; padding:1rem;">
    <button class="outline" @click="$store.promptStore.clear()">Clear All</button>
    <button class="contrast" @click="$store.promptStore.copyPrompt()">Copy Checked</button>
  </div>

  <!-- Semantic Search Input -->
  <form hx-get="/artists/search" 
        hx-swap="none" 
        style="margin-bottom: 1.5rem; display: flex; justify-content: center; gap: 0.5rem; width: 100%; max-width: 600px; margin-left: auto; margin-right: auto;">
    <input type="search" 
           name="q" 
           placeholder="Search artists by arbitrary visual style or phrase..." 
           style="margin-bottom: 0; flex-grow: 1;">
    <button type="submit" style="width: auto; margin-bottom: 0;">Search</button>
  </form>

  <div style="display:flex; gap:1rem; align-items:flex-start; min-height: 720px;">

    <!-- bottom list - Working List / Selected Artists List / Playground List / Prompt Builder -->
    <!-- docs: this list holds artists selected for the final prompt generation -->
    <div id="art-by-output"
         style="flex:1; padding:1rem; background:#f0f0f0;">

      <template x-for="(artist, index) in $store.promptStore.selectedArtists" :key="artist.id">
        <div style="display:flex; align-items:center; margin-bottom:0.5rem;">

          <!-- radio (focus) -->
          <input type="radio"
                 name="focusedArtist"
                 :checked="$store.promptStore.focusedId === artist.id"
                 @change="$store.promptStore.focusedId = artist.id"
                 style="margin-right:0.4rem;">

          <!-- checkbox (include in prompt) -->
          <input type="checkbox"
                 x-model="artist.checked"
                 style="margin-right:0.5rem; transform:scale(1.2);">

          <a style="flex:1; display:block;"
             :href="'#artist-' + artist.id"
             x-text="'art by ' + artist.name + ','"></a>

          <button class="secondary"
                  @click="$store.promptStore.moveUp(index)"
                  :disabled="index === 0"
                  style="margin-left:0.5rem;">↑</button>

          <button class="secondary"
                  @click="$store.promptStore.moveDown(index)"
                  :disabled="index === $store.promptStore.selectedArtists.length - 1"
                  style="margin-left:0.25rem;">↓</button>

          <button class="secondary"
                  @click="$store.promptStore.remove(artist.id)"
                  style="margin-left:0.25rem; color:red;">X</button>
        </div>
      </template>
    </div>

    <!-- preview panel -->
    <div style="width:460px;"
         x-show="$store.promptStore.focusedArtist"
         x-transition>

      <img :src="$store.promptStore.focusedArtist?.thumb"
            style="width:120px;">

      <strong x-text="$store.promptStore.focusedArtist?.name"></strong>
      <p x-text="$store.promptStore.focusedArtist?.desc"></p>

      <a :href="$store.promptStore.focusedArtist?.google"
         target="_blank">
        Google artist
      </a>
    </div>

  </div>
</div>
</div>



<script>

// Handle the custom event triggered by HTMX's backend response
window.addEventListener('checkSimilarArtists', function(e) {
    // 1. Log exactly what HTMX is giving us so we can see reality in the console
    console.log("=== HTMX TRIGGER EVENT CAUGHT ===");
    console.log("Raw event detail:", e.detail);

    let incomingIds = null;

    // 2. Safely extract the array based on how HTMX delivers it
    if (e.detail) {
      if (Array.isArray(e.detail)) {
        incomingIds = e.detail;
      } else if (e.detail.ids && Array.isArray(e.detail.ids)) {
        incomingIds = e.detail.ids;
      } else if (typeof e.detail === 'object') {
        // If HTMX passed it wrapped under the event name itself
        // or as an object value mapping
        const keys = Object.keys(e.detail);
        if (keys.length > 0 && Array.isArray(e.detail[keys[0]])) {
          incomingIds = e.detail[keys[0]];
        }
      }
    }

    // 3. Absolute Type Guard: If it's still not an array, do not crash!
    if (!incomingIds || !Array.isArray(incomingIds)) {
      console.error("Failed to find an array. Type of detail is:", typeof e.detail);
      return;
    }

    console.log("Successfully resolved array to loop:", incomingIds);

    // Clear the working list before adding new semantic matches
    if (window.Alpine) {
      Alpine.store('promptStore').clear();
    }

    // 4. Safe iteration using a standard classic loop to avoid prototype errors
    for (let i = 0; i < incomingIds.length; i++) {
      const id = String(incomingIds[i]);
      const cardEl = document.getElementById(`artist-${id}`);

      if (cardEl && window.Alpine) {
        const localData = window.Alpine.$data(cardEl);
        if (localData && localData.artist) {
          const promptStore = Alpine.store('promptStore');
          const alreadyAdded = promptStore.selectedArtists.some(a => a.id === id);

          if (!alreadyAdded) {
            promptStore.toggle(localData.artist);
          }
        }
      }
    }
  });

document.addEventListener('alpine:init', () => {
  Alpine.store('promptStore', {
    selectedArtists: [],
    focusedId: null,

    get focusedArtist() {
      return this.selectedArtists.find(a => a.id === this.focusedId)
    },

    toggle(artist) {
      const idx = this.selectedArtists.findIndex(a => a.id === artist.id)
      if (idx === -1) {
        this.selectedArtists.push({ ...artist, checked: true })
        if (!this.focusedId) this.focusedId = artist.id
      } else {
        this.selectedArtists.splice(idx, 1)
        if (this.focusedId === artist.id) {
          this.focusedId = this.selectedArtists.length ? this.selectedArtists[0].id : null
        }
      }
    },

    remove(id) {
      this.selectedArtists = this.selectedArtists.filter(a => a.id !== id)
      if (this.focusedId === id) {
        this.focusedId = this.selectedArtists.length ? this.selectedArtists[0].id : null
      }
    },

    moveUp(i) {
      if (i > 0) [this.selectedArtists[i-1], this.selectedArtists[i]] = [this.selectedArtists[i], this.selectedArtists[i-1]]
    },

    moveDown(i) {
      if (i < this.selectedArtists.length - 1) [this.selectedArtists[i], this.selectedArtists[i+1]] = [this.selectedArtists[i+1], this.selectedArtists[i]]
    },

    clear() {
      this.selectedArtists = []
      this.focusedId = null
    },

    copyPrompt() {
      const text = this.selectedArtists
        .filter(a => a.checked)
        .map(a => `art by ${a.name},`)
        .join('\n')
      navigator.clipboard.writeText(text)
    }
  })
})
</script>
</body>
</html>
{{end}}

{{define "grid_item"}}
<div class="grid-item" id="artist-{{.ID}}"
     x-data="{
        showActions: false,
        artist: {
            id: '{{.ID}}',
            name: '{{.Name | js}}',
            desc: '{{.Description | js}}',
            thumb: 'images/{{if .Thumb}}{{.Thumb}}{{else}}{{.ID}}.jpg{{end}}',
            google: 'https://www.google.com/search?q=art+by+{{.Name | urlquery}}'
        }
     }">
  <div class="grid-item-image">
    <img :src="artist.thumb" :alt="artist.name" loading="lazy">
  </div>
  <div class="grid-item-content">
    <h3 class="grid-item-title">
    <input type="checkbox"
             class="artist-checkbox"
             hx-get="/artists/similar-ids/{{.ID}}"
             hx-trigger="click[ctrlKey]"
             hx-swap="none"
             :checked="$store.promptStore.selectedArtists.some(a => a.id === artist.id)"
             @click="if ($event.ctrlKey) { $event.preventDefault(); } else { $store.promptStore.toggle(artist); }">
      <a :href="artist.google" target="_blank">{{.Name}}</a>
    </h3>
    <p class="grid-item-description">{{.Description}}
      <a href="#" @click.prevent="showActions = !showActions" class="action-trigger">⋯</a>
    </p>
    <div x-show="showActions" @click.away="showActions = false" class="action-links">
      <a href="#edit-section"
         hx-get="/artists/edit/{{.ID}}"
         hx-target="#edit-form-target"
         class="action-link">edit</a><br>
      <a href="#"
         hx-post="/artists/delete/{{.ID}}"
         hx-target="closest .grid-item"
         hx-swap="outerHTML"
         class="action-link"
         style="color: red;">delete</a>
    </div>
  </div>
</div>
{{end}}



{{define "edit_form_content"}}
<form hx-post="/artists/update/{{.ID}}" hx-target="#artist-{{.ID}}" hx-swap="outerHTML" hx-encoding="multipart/form-data">
    <div style="display: grid; gap: 1rem;">
        <label>Name: <input type="text" name="name" value="{{.Name}}">
        {{if .NameMsg}}
            <small class="form-help">{{.NameMsg}}</small>
        {{end}}
        </label>
        <div class="action-row">
            <a href="https://www.google.com/search?q=art+by+{{.Name | html}}" target="_blank">Google: {{.Name}}</a> | <a href="https://www.google.com/search?q=very+short+telegraphic+description+of+art+style+of+%22{{.Name | html}}%22+around+twenty+words%2C+return+results+as+paragraph%2C+do+not+use+a+list&amp;udm=50" target="_blank">AI</a> | <a href="https://www.google.com/search?q={{printf "Generate a \"Visual DNA\" profile for artist \"%s\". Output **only one line** following this exact format: Medium | Subject | Visual Traits | Style | Context. Keep it extremely concise and telegraphic. Example: woodblock print | landscapes, nature, weather | bokashi gradients, atmospheric composition, forced perspective | ukiyo-e | traditional japanese printmaking" .Name}}&udm=50" target="_blank">AI Features</a> | <a href="https://www.google.com/search?tbm=isch&amp;q=art+by+{{.Name | html}}+(filetype:jpg+OR+filetype:png)" target="_blank">JPG/PNG</a>
        </div>
        <label>Description: <textarea name="desc" rows="3">{{.Description}}</textarea>
        {{if .DescMsg}}
            <small class="form-help">{{.DescMsg}}</small>
        {{end}}
        </label>
        <label>Image (File or URL):
            <input type="file" name="image" accept=".png,.jpg,.jpeg">
            <input type="text" name="img_url" value="" placeholder="...or paste image URL" style="margin-top: 4px;">
        {{if .ImgMsg}}
            <small class="form-help">{{.ImgMsg}}</small>
        {{end}}
        </label>
        <label>Features: <textarea name="features" rows="3">{{.Features}}</textarea>
        {{if .FeaturesMsg}}
            <small class="form-help">{{.FeaturesMsg}}</small>
        {{end}}
        </label>
        <div style="display: flex; gap: 0.5rem;">
            <button type="submit">Save Changes</button>
            <button type="button" class="secondary" onclick="document.getElementById('edit-form-target').innerHTML = '<p>Click &quot;edit&quot; on a card above to load its data here.</p>'">Cancel</button>
        </div>
    </div>
</form>
{{end}}
