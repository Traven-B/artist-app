{{define "index"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>

    <link href="static/daft.css" rel="stylesheet" />
    <link href="static/daft-overrides.css" rel="stylesheet" />
    <link href="static/todo.css" rel="stylesheet" />
    <link href="static/env-ribbon.css" rel="stylesheet" />
    <link href="static/floating-nav.css" rel="stylesheet" />
    <link href="static/main.css" rel="stylesheet" />

    <title>Add Artist</title>
</head>
<body>
  {{if .IsTestMode}}
  <div class="env-ribbon">TEST MODE</div>
  {{end}}

  <div class="floating-nav">
    <div class="nav-circle" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Scroll to Top">▲</div>
    <div class="nav-circle" onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})" title="Scroll to Bottom">▼</div>
  </div>

  <!-- Header / Navigation -->
  <header class="container">
    <nav>
      <ul class="title">
        <li>
          <strong>Add Artist</strong>
          <a href="https://github.com/Traven-B/artist-app/blob/main/README.md" target="_blank" title="see project on github" style="vertical-align: middle; margin-left: 8px; display: inline-flex;">
            <svg height="30" viewBox="0 0 16 16" width="30" style="fill: currentColor; display: inline-block;">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>
        </li>
      </ul>
      <ul class="links">
        <li><a href="/">Add Artist</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="https://www.artbreeder.com/browse?modelNames=collage.&sort=trending" target="_blank">Artbreeder</a></li>
      </ul>
    </nav>
  </header>

  <!-- Main Measure -->
  <div class="measure add-artist-page">

    <!-- Artist To-Add List -->
    <div>
      <h2>Artists To Add</h2>
      <div style="display: flex; gap: 4px; margin-bottom: 8px;">
        <textarea 
            id="bulk-names" 
            name="names" 
            rows="1" 
            placeholder="Artist name(s)..." 
            style="flex-grow: 1; min-height: 1.5rem; vertical-align: middle;"></textarea>
        <button 
            type="button"
            hx-post="/add-to-todo-list" 
            hx-include="#bulk-names" 
            hx-target="#todo-list" 
            hx-on::after-request="document.getElementById('bulk-names').value=''">
            Add
        </button>
      </div>
      <div id="todo-status"></div>
      <ul id="todo-list">
        {{template "todo_list_items" .}}
      </ul>
    </div>

    <!-- Artist Form -->
    <div class="artist-form">
      <div id="artist-form">
        {{template "artist_form" .}}
      </div>
    </div>

  </div> <!-- end measure -->

  <!-- Dialog (static for now) -->
  {{template "confirm_dialog" .}}

</body>
</html>
{{end}}
